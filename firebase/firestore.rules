rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /collections/{userId} {
   allow read, write: if request.auth != null && request.auth.uid == userId;
  }
  match /t1Reports/{id} {
   function admin() { return request.auth != null && (request.auth.token.admin == true || request.auth.uid == 'Wh9yv5Jz2eUO8om8H0YNTmz1Qbs1'); }
   allow get: if !exists(/databases/$(database)/documents/t1Reports/$(id)) || resource.data.status == 'approved' || admin();
   allow list: if resource.data.status == 'approved' || admin();
   allow create: if request.auth != null
    && request.resource.data.keys().hasOnly(['category','player','serial','source','nickname','note','kind','edition','uid','photoPaths','status','createdAt'])
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.status == 'pending'
    && ((request.resource.data.get('category', 'card') == 'card'
      && request.resource.data.serial is int && request.resource.data.serial >= 1 && request.resource.data.serial <= 2025
      && id == 'KR-' + request.resource.data.player + '-' + string(request.resource.data.serial))
     || (request.resource.data.get('category', 'card') == 'box'
      && id.matches('KR-BOX-' + request.resource.data.player + '-[A-Za-z0-9]{20}')
      && request.resource.data.player in ['Doran','Oner','Faker','Keria']
      && !request.resource.data.keys().hasAny(['serial'])
      && request.resource.data.photoPaths.size() > 0))
    && request.resource.data.edition == 'KR'
    && request.resource.data.player in ['Doran','Oner','Faker','Gumayusi','Keria']
    && request.resource.data.kind in ['opened','sighting']
    && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 30
    && request.resource.data.note is string && request.resource.data.note.size() <= 300
    && request.resource.data.source is string && request.resource.data.source.size() <= 2048
    && (request.resource.data.source == '' || request.resource.data.source.matches('https?://.*'))
    && request.resource.data.photoPaths is list && request.resource.data.photoPaths.size() <= 3
    && request.resource.data.photoPaths.toSet().hasOnly(['t1Evidence/'+request.auth.uid+'/'+id+'/0.jpg','t1Evidence/'+request.auth.uid+'/'+id+'/1.jpg','t1Evidence/'+request.auth.uid+'/'+id+'/2.jpg'])
    && (request.resource.data.photoPaths.size() > 0 || request.resource.data.source.size() > 0)
    && request.resource.data.createdAt == request.time;
   allow update, delete: if admin();
  }
 }
}

